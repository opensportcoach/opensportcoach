{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "osc/push_plan",
  "title": "push_plan",
  "type": "object",
  "properties": {
    "kind": {
      "const": "push_plan"
    },
    "request_id": {
      "type": "string",
      "pattern": "^r\\d+$"
    },
    "athlete": {
      "type": "string",
      "minLength": 1
    },
    "display": {
      "type": "string",
      "minLength": 1
    },
    "garmin_account": {
      "type": "string",
      "minLength": 1
    },
    "protected": {
      "type": "integer",
      "minimum": 0
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "verb": {
            "enum": [
              "upload",
              "replace",
              "in_sync",
              "move",
              "schedule",
              "unschedule"
            ]
          },
          "workout": {
            "type": "string",
            "minLength": 1
          },
          "key": {
            "type": "string"
          },
          "old_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "workout_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "dates": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          "from": {
            "type": [
              "string",
              "null"
            ]
          },
          "to": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "verb",
          "workout"
        ],
        "additionalProperties": false
      }
    },
    "plan_hash": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{4,128}$"
    },
    "script": {
      "enum": [
        "sync",
        "reschedule"
      ]
    }
  },
  "required": [
    "kind",
    "request_id",
    "athlete",
    "garmin_account",
    "actions",
    "plan_hash",
    "script"
  ],
  "additionalProperties": false,
  "description": "A dry-run plan from sync_workouts.py / reschedule_workout.py --plan-json, for the confirm card."
}

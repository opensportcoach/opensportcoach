{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "osc/recap",
  "title": "recap",
  "type": "object",
  "properties": {
    "kind": {
      "const": "recap"
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "week": {
      "type": "string",
      "pattern": "^\\d{4}-W\\d{2}$"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "ok"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "up",
              "warn",
              "question"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "markdown": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "kind",
    "week",
    "checks",
    "findings"
  ],
  "additionalProperties": false,
  "description": "The weekly recap. Empty findings is 'no findings this week' — a designed outcome, not an error."
}

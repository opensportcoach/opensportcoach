{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "osc/race_check",
  "title": "race_check",
  "description": "The coach's online check of race dates (docs/DESIGN.md (races) §3), published after it is recorded in the athlete's races.json: per race, what the organiser's page, the entry or a listing said. Every id must be a race in races.json, and each entry must match the verified record there (scripts/app_contracts.py) — the page draws from the races view, never from this result's prose.",
  "type": "object",
  "properties": {
    "kind": {
      "const": "race_check"
    },
    "request_id": {
      "type": ["string", "null"],
      "pattern": "^r\\d+$"
    },
    "checked": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "races": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": ["confirmed", "differs", "unconfirmed"]
          },
          "source_kind": {
            "enum": ["official", "entry", "listing"]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "found": {
            "type": "object",
            "properties": {
              "date": {
                "type": ["string", "null"],
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "start": {
                "type": ["string", "null"]
              },
              "venue": {
                "type": ["string", "null"]
              }
            },
            "required": ["date"],
            "additionalProperties": false
          },
          "note": {
            "type": "string"
          }
        },
        "required": ["id", "status", "source_kind", "source", "found"],
        "additionalProperties": false
      }
    },
    "markdown": {
      "type": "string"
    }
  },
  "required": ["kind", "request_id", "checked", "races"],
  "additionalProperties": false
}

 "defs": {
  "recovery": {
   "source": "computed",
   "definition": "OpenSportCoach's recovery score, 0–100: five signals against your own 30-day usual, weighted HRV 40 %, resting HR 20 %, sleep vs need 25 %, respiration 10 %, skin temperature 5 %. At your usual, HRV and resting HR earn half their points, so a good ordinary morning scores about 65–75; 67 and up reads as recovered. A signal the watch didn't record hands its weight to the others."
  },
  "strain": {
   "source": "computed",
   "definition": "The day's Garmin training load mapped onto 0–21 (21 × load / 250, capped)."
  },
  "sleep_performance": {
   "source": "computed",
   "definition": "Sleep time as a share of Garmin's sleep need for the night."
  },
  "hrv": {
   "source": "garmin",
   "definition": "Average HRV across the night, from your watch."
  },
  "hrv_band": {
   "source": "garmin",
   "definition": "Garmin's own balanced range for your HRV (its baseline), from the night's HRV summary."
  },
  "hrv_weekly": {
   "source": "garmin",
   "definition": "Garmin's 7-night HRV average — what its HRV status compares with the balanced band."
  },
  "rhr": {
   "source": "garmin",
   "definition": "Resting heart rate for the day, from your watch."
  },
  "rhr_baseline": {
   "source": "computed",
   "definition": "Mean of the last 30 days' resting heart rate."
  },
  "rhr_7d": {
   "source": "computed",
   "definition": "7-day average: the mean of each day and the 6 before it, over the days with a reading (at least 4) — the trend the nightly numbers wobble around."
  },
  "readiness": {
   "source": "garmin",
   "definition": "Garmin training readiness, from the wake-up reading."
  },
  "fitness": {
   "source": "computed",
   "definition": "Fitness: Garmin load averaged with a 42-day exponential weight."
  },
  "fatigue": {
   "source": "computed",
   "definition": "Fatigue: Garmin load averaged with a 7-day exponential weight."
  },
  "form": {
   "source": "computed",
   "definition": "Form = fitness − fatigue."
  },
  "load": {
   "source": "garmin",
   "definition": "Garmin training load: EPOC, from heart rate. It barely registers lifting — read strength by tonnage and sets, never with cardio in one number."
  },
  "tonnage": {
   "source": "computed",
   "definition": "Σ weight × reps over every logged set, warm-ups included — they were lifted."
  },
  "weight": {
   "source": "garmin",
   "definition": "Body weight from your scale, via Garmin."
  },
  "bump": {
   "source": "computed",
   "definition": "Your latest session at the programmed load hit the target reps on every planned set."
  },
  "starved": {
   "source": "computed",
   "definition": "A program day not trained for more than 7 days."
  },
  "watch_sync": {
   "source": "computed",
   "definition": "Compared with what was last verified on your watch — no Garmin call."
  },
  "week_like_for_like": {
   "source": "computed",
   "definition": "This week up to its last finished day against last week up to the same day — never a part week against a whole one. Today counts once it logged a session and nothing planned for it is left."
  },
  "week_planned": {
   "source": "coach",
   "definition": "Still to come this week: Garmin's calendar and the coach's off-watch plan. Minutes: a gym day's estimate from the program, a watch workout's own estimate, else your median time for that sport over its last five sessions (≈)."
  },
  "week_target": {
   "source": "coach",
   "definition": "The coach's weekly band for this number (program WEEK_TARGETS; cardio load from your profile). Without one the row only says how it moved."
  },
  "sleep_need": {
   "source": "garmin",
   "definition": "Garmin's sleep need for each night, averaged over the nights so far."
  },
  "race_countdown": {
   "source": "computed",
   "definition": "Days to race day; the countdown shows from 8 weeks out."
  },
  "race_easy": {
   "source": "coach",
   "definition": "An easy day before a race: no sprints, VO2 work, threshold work or tests, and no heavy legs. Easy aerobic work, mobility and a lighter upper-body gym day are fine."
  },
  "race_taper": {
   "source": "coach",
   "definition": "A taper day before an A race: the volume comes down by about half over the taper, and short race-pace efforts stay in."
  },
  "race_day": {
   "source": "coach",
   "definition": "Race day: the race, its warm-up and its fuelling, and nothing else."
  },
  "race_recovery": {
   "source": "coach",
   "definition": "A recovery day after a race: no intensity, and no long ride or long run. Easy aerobic work and mobility, and a light gym day from the second day. After an A race, short intensity may come back once its no-intensity days are over."
  },
  "fuel_band": {
   "source": "computed",
   "definition": "Carbohydrate during a session, by its length, how hard it is and the sport. Under an hour: none. 60–90 min: none if easy, about 30 g/h if hard. 90 min to 2.5 h: 30–60 g/h easy, about 60 hard. Over 2.5 h: 60–90 g/h of glucose and fructose. Runs take the lower half of each band; swims none. Sources: ACSM 2016; Jeukendrup 2014."
  },
  "fuel_target": {
   "source": "computed",
   "definition": "The rate planned: the top of a hard session's band, the middle of an easy one's, never above what your gut is trained to (60 g/h until you say otherwise), plus 10 g/h on a gut-training session."
  },
  "fuel_gut": {
   "source": "you",
   "definition": "The most carbohydrate an hour you have taken in training without trouble. Raised 10 g/h at a time, only after a logged session at the current rate."
  },
  "fuel_taken": {
   "source": "you",
   "definition": "What you logged taking, in grams, from each product's label and your bottle recipe as it was that day. Self-reported: Garmin does not record it."
  }
 }
}

  },
  "watch_sync": {
   "source": "computed",
   "definition": "Compared with what was last verified on your watch — no Garmin call."
  },
  "est_time": {
   "source": "computed",
   "definition": "Estimated: sets × work time (≈3 s a rep, the prescribed time for timed work, both sides for per-side work, 20 s a power set) + the watch's rest between series + 30 s a lap between exercises + 90 s a warm-up set."
  },
  "phase": {
   "source": "computed",
   "definition": "Phase in the day, in order: core block → power before the first main lift → the first loaded lift (strength) → timed and athletic work after it (functional) → the rest (hypertrophy). The program can name a phase itself."
  },
  "next_target": {
   "source": "computed",
   "definition": "Double progression: the top of the range on every set earns the next step — barbell 2.5 kg, dumbbell 2 kg, dumbbell light 1 kg, cable 2.5 kg, machine 5 kg, plates 5 kg, added 2.5 kg (dumbbells per hand; plates on a machine)."
  },
  "planned_volume": {
   "source": "computed",
   "definition": "Working sets per muscle in one week of the program — every gym day once, optional days left out, warm-ups excluded. Speed, jump, throw, sled and rope work counts in the Athletic bucket, never as muscle volume."
  },
  "e1rm": {
   "source": "computed",
   "definition": "Estimated 1-rep max (Epley): load × (1 + reps / 30), reps capped at 12. Per-hand lifts use the per-hand load; plate-loaded machines have none."
  }

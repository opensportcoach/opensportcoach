 "defs": {
  "e1rm": {
   "source": "computed",
   "definition": "Estimated 1-rep max (Epley): load × (1 + reps / 30), reps capped at 12. Per-hand lifts use the per-hand load; plate-loaded machines have none."
  },
  "tonnage": {
   "source": "computed",
   "definition": "Σ weight × reps over every logged set, warm-ups included — they were lifted."
  },
  "load": {
   "source": "garmin",
   "definition": "Garmin training load: EPOC, from heart rate. It barely registers lifting — read strength by tonnage and sets, never with cardio in one number."
  },
  "fuel_band": {
   "source": "computed",
   "definition": "Carbohydrate during a session, by its length, how hard it is and the sport. Under an hour: none. 60–90 min: none if easy, about 30 g/h if hard. 90 min to 2.5 h: 30–60 g/h easy, about 60 hard. Over 2.5 h: 60–90 g/h of glucose and fructose. Runs take the lower half of each band; swims none. Sources: ACSM 2016; Jeukendrup 2014."
  },
  "fuel_target": {
   "source": "computed",
   "definition": "The rate planned: the top of a hard session's band, the middle of an easy one's, never above what your gut is trained to (60 g/h until you say otherwise), plus 10 g/h on a gut-training session."
  },
  "fuel_gut": {
   "source": "you",
   "definition": "The most carbohydrate an hour you have taken in training without trouble. Raised 10 g/h at a time, only after a logged session at the current rate."
  },
  "fuel_taken": {
   "source": "you",
   "definition": "What you logged taking, in grams, from each product's label and your bottle recipe as it was that day. Self-reported: Garmin does not record it."
  },
  "score": {
   "source": "computed",
   "definition": "How the session went against what was planned for it that day, 0–100. Execution, not fitness: heat, decoupling and efficiency stay flags. Each part scores 0–1 and earns its weight; a part that cannot be scored drops out and the others rescale. Under 60 % of the session scored, no total. 85+ As planned · 70–84 Mostly · 50–69 Partly · under 50 Off plan · under 60 % scored: Unclear. A gym session with a planned exercise not started scores 84 at most."
  },
  "score_sets": {
   "source": "computed",
   "definition": "Working sets done ÷ planned, per exercise, capped at planned: extra sets add nothing."
  },
  "score_reps": {
   "source": "computed",
   "definition": "Per planned set, reps (or seconds) done ÷ target, capped at 1. A per-side set is scored per side."
  },
  "score_load": {
   "source": "computed",
   "definition": "Per planned set, the load in the program's terms (per hand, discs on a machine) ÷ the ask, capped at 1; on a weighted bodyweight lift, body plus plate. More than 15 % over is flagged, not rewarded; near double means suspect the implement. A lift done on a different machine is not comparable and drops out."
  },
  "score_rest": {
   "source": "computed",
   "definition": "Share of rests between sets within 0.75–1.5 × the prescribed rest. Weighted low: rest runs on the lap button."
  },
  "score_intent": {
   "source": "computed",
   "definition": "Easy and tempo rides: the share of time in the intent's band (power against your FTP, else the activity's own HR zones); 85 % scores full. On an easy ride, time under the band counts half. Interval rides: IF inside the intent's band."
  },
  "score_intervals": {
   "source": "computed",
   "definition": "Only when the plan sets work: time at the target's low end −5 % or better (3-second power), held 20 s or more, ÷ the work planned."
  },
  "score_duration": {
   "source": "computed",
   "definition": "Moving time against the plan, both ways: ±10 % scores full, ±50 % nothing."
  },
  "score_pacing": {
   "source": "computed",
   "definition": "Steady rides: variability index, 1.05 or under full, 1.20 nothing. Runs: second half's pace within 3 % of the first. Not scored on interval rides."
  },
  "score_fuel": {
   "source": "computed",
   "definition": "Only when a fuel plan existed: grams taken ÷ planned, capped at 1. A log with no grams drops out."
  },
  "score_distance": {
   "source": "computed",
   "definition": "Metres swum against the metres planned, both ways: within 10 % scores full, 50 % off nothing."
  },
  "score_swims": {
   "source": "computed",
   "definition": "Planned swims done, in order (the lap's distance matching the planned rep's) ÷ planned swims."
  },
  "score_swim_pacing": {
   "source": "computed",
   "definition": "Per set of repeated swims, the spread of pace across its reps: 3 % or under full, 10 % nothing."
  },
  "score_steps": {
   "source": "computed",
   "definition": "Working steps of the planned circuit done (a lap of its own, not a stray press) ÷ planned."
  },
  "score_structure": {
   "source": "computed",
   "definition": "Laps against the planned steps: the same number scores full; each lap more or fewer costs its share. A stray lap press shifts every step after it."
  },
  "score_circuit_pacing": {
   "source": "computed",
   "definition": "The spread of the run legs' times: 5 % or under full, 20 % nothing."
  }
 }
}

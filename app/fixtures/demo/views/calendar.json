 "defs": {
  "watch_sync": {
   "source": "computed",
   "definition": "Compared with what was last verified on your watch — no Garmin call."
  },
  "race_easy": {
   "source": "coach",
   "definition": "An easy day before a race: no sprints, VO2 work, threshold work or tests, and no heavy legs. Easy aerobic work, mobility and a lighter upper-body gym day are fine."
  },
  "race_taper": {
   "source": "coach",
   "definition": "A taper day before an A race: the volume comes down by about half over the taper, and short race-pace efforts stay in."
  },
  "race_day": {
   "source": "coach",
   "definition": "Race day: the race, its warm-up and its fuelling, and nothing else."
  },
  "race_recovery": {
   "source": "coach",
   "definition": "A recovery day after a race: no intensity, and no long ride or long run. Easy aerobic work and mobility, and a light gym day from the second day. After an A race, short intensity may come back once its no-intensity days are over."
  },
  "fuel_band": {
   "source": "computed",
   "definition": "Carbohydrate during a session, by its length, how hard it is and the sport. Under an hour: none. 60–90 min: none if easy, about 30 g/h if hard. 90 min to under 2.5 h: 30–60 g/h easy, about 60 hard. 2.5 h or more: 60–90 g/h of glucose and fructose. Runs take the lower half of each band; swims none. Sources: ACSM 2016; Jeukendrup 2014."
  },
  "fuel_target": {
   "source": "computed",
   "definition": "The rate planned: the top of a hard session's band, the middle of an easy one's, never above what your gut is trained to (60 g/h until you say otherwise), plus 10 g/h on a gut-training session."
  },
  "trip": {
   "source": "you",
   "definition": "A trip is the days you are away from your usual setup, the first and last included. For each place — gym, pool, bike, indoor trainer, running, courts — it says yes, maybe or no."
  },
  "trip_maybe": {
   "source": "coach",
   "definition": "Not sure yet: planned as not there until you confirm it."
  },
  "trip_travel": {
   "source": "coach",
   "definition": "A travel day: kept light — no intensity and no test — with only what the trip has, unless you leave after the morning or are back before the evening: then one session at home fits."
  },
  "trip_limited": {
   "source": "coach",
   "definition": "Limited time: short sessions, and every one optional — skipping one is not a miss."
  },
  "trip_clash": {
   "source": "computed",
   "definition": "A session planned on a trip day that needs something the trip doesn't have, or a hard session or a test on a travel day. Read from your plan and the watch's calendar, with no Garmin call."
  }
 }

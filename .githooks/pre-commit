#!/usr/bin/env python3
"""Git pre-commit hook: one athlete per commit, and never another athlete's files from a bound
Claude session.

Enabled once per clone with:  git config core.hooksPath .githooks

  * A commit may touch engine files and AT MOST ONE athlete's folder (athletes/<name>/). A commit
    spanning two athletes is how one person's plan ends up in the other's history.
  * Inside a Claude session bound to an athlete (OSC_SESSION -> data/sessions/), it may only
    touch THAT athlete's folder.
Renames are checked on both sides, so moving a file from one athlete to another is caught too.
  * A merge is judged by what it changes itself: an athlete file it brings in unchanged from either
    branch was already checked in that branch's own commit. A file changed while resolving the merge
    still counts.
  * In the public repository (which ignores athletes/), nothing personal may be committed anywhere:
    scripts/leak_scan.py checks every staged file.
"""
from __future__ import annotations

import subprocess
import sys
from pathlib import Path

root = Path(subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True,
                           text=True, check=True).stdout.strip())
sys.path.insert(0, str(root / "scripts"))
import athlete  # noqa: E402


def athletes_touched(paths: list[str]) -> set[str]:
    return {p.split("/")[1] for p in paths if p.startswith("athletes/") and p.count("/") >= 2}


def check(paths: list[str], bound: str | None) -> str | None:
    touched = athletes_touched(paths)
    if len(touched) > 1:
        return (f"this commit touches {len(touched)} athletes ({', '.join(sorted(touched))}). "
                "Commit each athlete's changes separately.")
    if bound and touched - {bound}:
        return (f"this session is bound to {bound} but the commit touches "
                f"athletes/{sorted(touched - {bound})[0]}/.")
    return None


def _blob(spec: str) -> str | None:
    r = subprocess.run(["git", "rev-parse", "--verify", "--quiet", spec], capture_output=True, text=True)
    return r.stdout.strip() or None


def merged_unchanged(paths: list[str]) -> set[str]:
    """In a merge, the athlete files identical to their version on one of the two branches: each arrived
    in a commit of its own that already passed this hook. What the merge itself changes (a resolved
    conflict) is not in this set, so it still counts."""
    git_dir = Path(subprocess.run(["git", "rev-parse", "--git-dir"], capture_output=True, text=True,
                                  check=True).stdout.strip())
    if not (git_dir / "MERGE_HEAD").exists():
        return set()
    return {p for p in paths if (b := _blob(f":{p}")) and b in (_blob(f"HEAD:{p}"), _blob(f"MERGE_HEAD:{p}"))}


def main() -> int:
    staged = subprocess.run(["git", "diff", "--cached", "--name-only", "--no-renames"],
                            capture_output=True, text=True, check=True).stdout.split()
    brought = merged_unchanged([p for p in staged if p.startswith("athletes/")])
    problem = check([p for p in staged if p not in brought], athlete.bound_name())
    if problem:
        print(f"pre-commit (OpenSportCoach athlete guard): {problem}", file=sys.stderr)
        return 1
    # Personal data outside athletes/ (scripts/leak_scan.py). Blocking in a repository that ignores the
    # athletes' folders — the public one; a private repository that tracks them on purpose is left alone.
    import leak_scan
    if leak_scan.private_dirs_ignored():
        hits = leak_scan.scan(leak_scan._staged(), staged=True)
        if hits:
            print("pre-commit (OpenSportCoach leak scan): personal data outside an athlete's folder:",
                  file=sys.stderr)
            for h in hits:
                print(f"  {h}", file=sys.stderr)
            return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3
"""pre-commit for the athletes' own private repository — athletes/, nested inside OpenSportCoach.

The public repository ignores athletes/; an athlete who wants history for their folder makes it a git
repository of its own. Its commits never pass the engine's hook, so this one runs the same rule there:
one athlete per commit, and never another athlete's folder from a session bound to someone else.

Enable once, from the OpenSportCoach folder:
    git -C athletes config core.hooksPath ../.githooks/athletes
"""
from __future__ import annotations

import importlib.machinery
import importlib.util
import subprocess
import sys
from pathlib import Path

engine_hook = Path(__file__).resolve().parent.parent / "pre-commit"
loader = importlib.machinery.SourceFileLoader("osc_precommit", str(engine_hook))
hook = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
loader.exec_module(hook)


def main() -> int:
    # Paths here are relative to athletes/ ("rocky/logs/x.md"): the engine's check reads them as
    # athletes/<name>/..., so they are prefixed.
    staged = subprocess.run(["git", "diff", "--cached", "--name-only", "--no-renames"],
                            capture_output=True, text=True, check=True).stdout.split()
    brought = hook.merged_unchanged(staged)
    problem = hook.check([f"athletes/{p}" for p in staged if p not in brought], hook.athlete.bound_name())
    if problem:
        print(f"pre-commit (OpenSportCoach athlete guard, athletes repository): {problem}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
